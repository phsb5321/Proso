bucket = "proso-tfstate-699475944323"
key    = "00-bootstrap/terraform.tfstate"
region = "us-east-1"

# `kms_key_id` is not optional here even though the bucket has a KMS default:
# with `encrypt = true` alone the backend sends x-amz-server-side-encryption:
# AES256, which the bucket's DenyUnencryptedWrites policy rejects. The alias ARN
# is used rather than the key id so this file is deterministic before the first
# apply; S3 resolves it to the key. Verified on the live object:
#   aws s3api head-object --bucket proso-tfstate-699475944323 \
#       --key 00-bootstrap/terraform.tfstate
#   -> "SSEKMSKeyId": ".../key/2056b8bb-f931-4a04-9468-98f9ae062dcd"
encrypt    = true
kms_key_id = "arn:aws:kms:us-east-1:699475944323:alias/proso-tfstate-699475944323"

# S3-native locking (Terraform >= 1.11). No DynamoDB table exists or should be
# created — and could not be: the sandbox-guardrails SCP denies
# dynamodb:CreateTable.
use_lockfile = true

# The ambient session is already `proso-deploy` for routine work. Do not add an
# assume_role here: doing so forces that scoped role back through the bootstrap
# administrator role and makes its own drift plan fail. The historical first
# migration used a temporary assume-role override; the backend no longer needs
# it now that the scoped role exists.
