{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOrgIamAndIdentityCenterMetadata",
      "Effect": "Allow",
      "Action": [
        "organizations:Describe*",
        "organizations:List*",
        "iam:Get*",
        "iam:List*",
        "iam:GenerateCredentialReport",
        "iam:GenerateServiceLastAccessedDetails",
        "sso:Describe*",
        "sso:List*",
        "sso-directory:Describe*",
        "sso-directory:List*",
        "identitystore:Describe*",
        "identitystore:List*",
        "account:Get*",
        "account:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageSpendVisibility",
      "Effect": "Allow",
      "Action": [
        "budgets:*",
        "ce:Get*",
        "ce:List*",
        "ce:Describe*",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*",
        "cloudtrail:LookupEvents",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "sns:Get*",
        "sns:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AuditBackupPostureWithoutReadingBackups",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketLogging",
        "s3:GetBucketTagging",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBackupContentsAndAnyBucketMutation",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject*",
        "s3:PutObject*",
        "s3:DeleteObject*",
        "s3:RestoreObject",
        "s3:ReplicateObject",
        "s3:BypassGovernanceRetention",
        "s3:CreateBucket",
        "s3:DeleteBucket*",
        "s3:PutBucket*",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutAccountPublicAccessBlock",
        "secretsmanager:*",
        "ssm:GetParameter*",
        "kms:Decrypt",
        "kms:GenerateDataKey*"
      ],
      "Resource": "*"
    }
  ]
}
