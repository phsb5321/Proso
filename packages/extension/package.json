{
  "name": "@proso/extension",
  "version": "1.2.12",
  "private": true,
  "type": "module",
  "description": "Proso Firefox Extension - Text-to-Speech for any webpage",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox-listed": "PROSO_LISTED=1 wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:all": "wxt build -b firefox && wxt build -b chrome && wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:firefox-listed": "PROSO_LISTED=1 wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "postinstall": "wxt prepare",
    "test": "pnpm run lint && NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects unit",
    "test:contract": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects contract",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects integration",
    "test:security": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects security",
    "test:regression": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects regression",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:visual": "npx playwright test --project=firefox-visual",
    "test:visual:update": "npx playwright test --project=firefox-visual --update-snapshots",
    "test:e2e": "npx playwright test --project=firefox-e2e",
    "test:e2e:ext": "npx playwright test --project=chromium-extension",
    "test:e2e:ext:ui": "npx playwright test --project=chromium-extension --ui",
    "test:e2e:ext:docker": "PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:3000/ npx playwright test --project=chromium-extension",
    "validate:firefox": "web-ext run --source-dir=.output/firefox-mv2 --firefox=${FIREFOX_BIN:-firefox-nightly}",
    "test:all": "pnpm run test && pnpm run test:visual",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "lint:manifest": "web-ext lint --source-dir .output/firefox-mv2",
    "deps:check": "madge --extensions ts --circular src/entrypoints/ src/utils/",
    "deps:graph": "madge --image deps.svg src/entrypoints/ src/utils/",
    "duplication": "jscpd --threshold 10 --min-tokens 50 --max-lines 10000 --max-size 1mb src/entrypoints/ src/utils/",
    "quality": "pnpm run deps:check && pnpm run duplication",
    "icons:generate": "node scripts/generate-icons.mjs --run",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "version:show": "./scripts/version.sh",
    "version:patch": "./scripts/version.sh patch",
    "version:minor": "./scripts/version.sh minor",
    "version:major": "./scripts/version.sh major",
    "prerelease": "pnpm run test && pnpm run quality && pnpm run build:all",
    "diagnostics:chrome-mv3": "node ../../scripts/chrome-mv3-diagnostics.mjs"
  },
  "dependencies": {
    "@proso/shared": "workspace:*",
    "@webext-core/messaging": "^2.3.0",
    "dexie": "^4.2.1",
    "franc-min": "^6.2.0",
    "lamejs": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@iconify-json/lucide": "^1.2.45",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@unocss/preset-rem-to-px": "^66.1.0",
    "@wxt-dev/unocss": "^1.0.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "4.9.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-webextension-mock": "^3.9.0",
    "jscpd": "^4.0.5",
    "jsdom": "^20.0.3",
    "madge": "^8.0.0",
    "svgo": "4.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "unocss": "^66.1.0",
    "web-ext": "^7.11.0",
    "wxt": "^0.20.13"
  },
  "keywords": ["firefox", "extension", "tts", "text-to-speech", "accessibility"],
  "license": "AGPL-3.0-or-later"
}
