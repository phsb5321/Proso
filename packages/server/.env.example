# VoxPage Server Environment Variables
# Copy to .env for local development

# Server
PORT=5000
NODE_ENV=development

# Database (Dokku provides DATABASE_URL via postgres:link)
DATABASE_URL=postgresql://user:password@localhost:5432/voxpage?schema=public

# Redis (Dokku provides REDIS_URL via redis:link)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-jwt-secret-here

# Paddle Billing
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# TTS Provider API Keys
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# Logging
LOG_LEVEL=debug
LOKI_HOST=
