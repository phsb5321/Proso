{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["../../biome.json"],
  "javascript": {
    "globals": [],
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off",
        "useNodejsImportProtocol": "warn"
      }
    }
  },
  "files": {
    "ignore": ["dist/**", "node_modules/**", "coverage/**", "prisma/**", "src/generated/**"]
  }
}
