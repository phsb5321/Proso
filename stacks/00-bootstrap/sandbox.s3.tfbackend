bucket = "proso-tfstate-699475944323"
key    = "00-bootstrap/terraform.tfstate"
region = "us-east-1"

# `kms_key_id` is not optional here even though the bucket has a KMS default:
# with `encrypt = true` alone the backend sends x-amz-server-side-encryption:
# AES256, which the bucket's DenyUnencryptedWrites policy rejects. The alias
# ARN is used rather than the key id so this file is deterministic before the
# first apply.
encrypt    = true
kms_key_id = "arn:aws:kms:us-east-1:699475944323:alias/proso-tfstate-699475944323"

# S3-native locking (Terraform >= 1.11). No DynamoDB table exists or should be
# created — and could not be: the SandboxRestrictions SCP denies
# dynamodb:CreateTable outright.
use_lockfile = true
