{
  "name": "proso",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "description": "Proso - Text-to-Speech for any webpage (monorepo)",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "postinstall": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.1.2",
    "typescript": "^5.9.3"
  },
  "keywords": ["firefox", "extension", "tts", "text-to-speech", "accessibility"],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
