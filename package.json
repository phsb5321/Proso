{
  "name": "voxpage",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "VoxPage Firefox Extension - Text-to-Speech for any webpage",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:all": "wxt build -b firefox && wxt build -b chrome && wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "postinstall": "wxt prepare",
    "test": "pnpm run lint && NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects unit",
    "test:contract": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects contract",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects integration",
    "test:security": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects security",
    "test:regression": "NODE_OPTIONS='--experimental-vm-modules' jest --selectProjects regression",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:visual": "npx playwright test --project=firefox-visual",
    "test:visual:update": "npx playwright test --project=firefox-visual --update-snapshots",
    "test:e2e": "npx playwright test --project=firefox-e2e",
    "test:e2e:ext": "npx playwright test --project=chromium-extension",
    "test:e2e:ext:ui": "npx playwright test --project=chromium-extension --ui",
    "test:e2e:ext:docker": "PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:3000/ npx playwright test --project=chromium-extension",
    "validate:firefox": "web-ext run --source-dir=.output/firefox-mv2",
    "test:all": "pnpm run test && pnpm run test:visual",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "lint:manifest": "web-ext lint --source-dir .output/firefox-mv2",
    "deps:check": "madge --circular src/entrypoints/ src/utils/",
    "deps:graph": "madge --image deps.svg src/entrypoints/ src/utils/",
    "duplication": "jscpd --threshold 10 --min-tokens 50 src/entrypoints/ src/utils/",
    "quality": "pnpm run deps:check && pnpm run duplication && pnpm run lint:manifest",
    "version:show": "./scripts/version.sh",
    "version:patch": "./scripts/version.sh patch",
    "version:minor": "./scripts/version.sh minor",
    "version:major": "./scripts/version.sh major",
    "prerelease": "pnpm run test && pnpm run quality && pnpm run build:all"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@types/webextension-polyfill": "^0.10.7",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-webextension-mock": "^3.9.0",
    "jscpd": "^4.0.5",
    "madge": "^8.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "web-ext": "^7.11.0",
    "wxt": "^0.20.13"
  },
  "keywords": [
    "firefox",
    "extension",
    "tts",
    "text-to-speech",
    "accessibility"
  ],
  "license": "MIT",
  "dependencies": {
    "@webext-core/messaging": "^2.3.0",
    "dexie": "^4.2.1",
    "franc-min": "^6.2.0",
    "lamejs": "^1.2.1",
    "zod": "^3.23.8"
  }
}
