{
  "name": "proso",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "description": "Proso - Text-to-Speech for any webpage (monorepo)",
  "scripts": {
    "build": "pnpm -r build",
    "build:chrome": "pnpm --filter @proso/extension build:chrome",
    "build:firefox": "pnpm --filter @proso/extension build:firefox",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @proso/extension test:unit",
    "lint": "pnpm -r lint",
    "quality": "pnpm --filter @proso/extension quality",
    "zip:chrome": "pnpm --filter @proso/extension zip:chrome && ./scripts/stage-extension-release.sh chrome",
    "zip:firefox": "pnpm --filter @proso/extension zip:firefox && ./scripts/stage-extension-release.sh firefox",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:fix": "knip --fix --allow-remove-files",
    "postinstall": "if git rev-parse --git-dir >/dev/null 2>&1; then hooks_path=$(git config --get core.hooksPath 2>/dev/null); status=$?; if [ \"$status\" -eq 0 ]; then [ -n \"$hooks_path\" ] || lefthook install; elif [ \"$status\" -eq 1 ]; then lefthook install; else exit \"$status\"; fi; fi"
  },
  "devDependencies": {
    "dependency-cruiser": "17.4.3",
    "jsdom": "^20.0.3",
    "knip": "6.6.2",
    "lefthook": "^2.1.2",
    "typescript": "^5.9.3"
  },
  "keywords": ["firefox", "extension", "tts", "text-to-speech", "accessibility"],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
