# Gateway Environment Variables

# Server configuration
PORT=3000

# Authentication token for extension requests
# Generate with: openssl rand -base64 32
GATEWAY_TOKEN=your-secure-token-here

# Loki configuration (internal Dokku network)
LOKI_URL=http://loki.web.1:3100

# Optional: Loki basic auth (if enabled)
# LOKI_USER=
# LOKI_PASSWORD=

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=60

# Environment
NODE_ENV=production
