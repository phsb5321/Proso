# Agent runtime config - machine-specific, keep local
CLAUDE.md
.claude/
.mcp.json
.opencode/

# Spec-driven development artifacts ARE tracked - see AGENTS.md "Spec-Driven
# Development". `specs/` and `.specify/` deliberately do not appear above:
# a spec that is not in the diff cannot be reviewed with the code it governs.
# Only the pre-monorepo archive stays out; it is 4.4M of superseded history
# that no reviewer reads.
specs/_archive/

# Dependencies
# Both spellings on purpose. `node_modules/` matches only a DIRECTORY, so a
# `node_modules` SYMLINK (the usual way to share deps into a git worktree)
# stays untracked-visible and can be committed by `git add -A`. That happened
# in PR #202 and broke every CI job with
# `ENOTDIR: not a directory, mkdir '/workspace/pedro/proso/node_modules'`,
# because pnpm cannot create the directory over a checked-out symlink.
node_modules/
node_modules
.pnpm-store/

# Build outputs
*.xpi
*.zip
web-ext-artifacts/
.wxt/
.output/
# Listed (Mozilla-hosted) build variant — same code as .output, minus update_url.
.output-listed/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
.copilot/
.cursor/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log

# Environment/Secrets (never commit these!)
.env
.env.local
.env.*
!.env.example
secrets.json
*.key
*.pem

# Placeholder files
*.placeholder

# Test artifacts
test-results/
playwright-report/
report/
coverage/

# ESLint cache
.eslintcache

# TypeScript build info (incremental compilation)
*.tsbuildinfo

# Smoke-reading run receipts
.artifacts/
