# Agent runtime config - machine-specific, keep local
CLAUDE.md
.claude/
.mcp.json
.opencode/

# Spec-driven development artifacts ARE tracked - see AGENTS.md "Spec-Driven
# Development". `specs/` and `.specify/` deliberately do not appear above:
# a spec that is not in the diff cannot be reviewed with the code it governs.
# Only the pre-monorepo archive stays out; it is 4.4M of superseded history
# that no reviewer reads.
specs/_archive/

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
*.xpi
*.zip
web-ext-artifacts/
.wxt/
.output/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
.copilot/
.cursor/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log

# Environment/Secrets (never commit these!)
.env
.env.local
.env.*
!.env.example
secrets.json
*.key
*.pem

# Placeholder files
*.placeholder

# Test artifacts
test-results/
playwright-report/
report/
coverage/

# ESLint cache
.eslintcache

# TypeScript build info (incremental compilation)
*.tsbuildinfo

# Smoke-reading run receipts
.artifacts/
